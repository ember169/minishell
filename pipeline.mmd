%%{init: {
  "theme": "base",
  "themeVariables": {
    "background":          "#181825",
    "mainBkg":             "#1e1e2e",
    "primaryColor":        "#1e1e2e",
    "primaryTextColor":    "#cdd6f4",
    "primaryBorderColor":  "#89b4fa",
    "secondaryColor":      "#313244",
    "tertiaryColor":       "#181825",
    "nodeBorder":          "#89b4fa",
    "clusterBkg":          "#11111b",
    "clusterBorder":       "#585b70",
    "titleColor":          "#cdd6f4",
    "edgeLabelBackground": "#313244",
    "fontFamily":          "monospace",
    "fontSize":            "13px"
  }
}}%%
flowchart TD
    %% ─── INPUT ───────────────────────────────────────────────────────────────
    subgraph INPUT["Stage 1 · User Input  (main.c)"]
        direction TB
        RL["readline(PROMPT)"]
        RAW["char *uinput\n= &quot;env | grep $USER&quot;"]
        HIST["add_to_history()"]
        PI["_process_input(ms, uinput)"]
        RL --> RAW
        RAW --> HIST
        RAW --> PI
    end

    %% ─── LEXER ───────────────────────────────────────────────────────────────
    subgraph LEXER["Stage 2 · Lexer  (srcs/lexer/)"]
        direction TB
        LX["lexer(input)\nlexer.c:74"]
        LSM["t_lexer_state\n{ state=GENERAL, i=0 }"]
        PC["_process_character()"]

        subgraph DISPATCH["character dispatch"]
            direction LR
            EW["_extract_word()\n→ ft_substr()\n→ TOK_WORD"]
            HQ["handle_quotes()\nstate=IN_QUOTE\n→ TOK_WORD (with delimiters)"]
            HO["handle_operator()\n_append_op()\n→ TOK_PIPE / TOK_AND …"]
            SK["skip\n(is_space)"]
        end

        TN["token_new(value, type)"]
        TAB["token_add_back()"]
        TOK_LIST["t_token linked list\n[TOK_WORD:&quot;env&quot;] → [TOK_PIPE] → [TOK_WORD:&quot;grep&quot;] → [TOK_WORD:&quot;$USER&quot;]"]

        LX --> LSM
        LSM --> PC
        PC --> DISPATCH
        EW --> TN
        HQ --> TN
        HO --> TN
        TN --> TAB
        TAB --> TOK_LIST
    end

    %% ─── EXPANDER ────────────────────────────────────────────────────────────
    subgraph EXPANDER["Stage 3 · Expander  (srcs/expander/)"]
        direction TB
        ETL["expand_token_list(ms, list)\nexpander.c:53"]

        subgraph WORD_LOOP["for each TOK_WORD"]
            direction TB
            EWQ["_expand_with_quotes(ms, value)\n→ expand_loop()"]
            EWP["_expand_with_path()\n(glob * expansion)"]
        end

        subgraph VAR_EXPAND["$USER expansion  (expand_loop)"]
            direction TB
            DOLLAR["detect '$' &amp;&amp; in_quote ≠ '\''"]
            KL["get_key_len('$USER') → 4"]
            GEV["get_env_var(ms, '$USER', &amp;var)\n  ft_substr → key='USER'\n  get_env_addr_from_key → t_env node\n  ft_strdup(env→value) → &quot;mskn&quot;"]
            AV["_append_var(dst, &quot;mskn&quot;)\nsrc += 1 + key_len"]
        end

        QUOTE_RULE["Single quotes protect $:\nin_quote == '\\'' → skip _expand_one_var()"]
        TOK_LIST2["t_token linked list (mutated)\n[TOK_WORD:&quot;env&quot;] → [TOK_PIPE] → [TOK_WORD:&quot;grep&quot;] → [TOK_WORD:&quot;mskn&quot;]"]

        ETL --> WORD_LOOP
        EWQ --> VAR_EXPAND
        DOLLAR --> KL --> GEV --> AV
        AV --> EWP
        EWP --> TOK_LIST2
        ETL -.->|"'…' context"| QUOTE_RULE
    end

    %% ─── PARSER ──────────────────────────────────────────────────────────────
    subgraph PARSER["Stage 4 · Parser / AST Builder  (srcs/parser/)"]
        direction TB
        BA["build_ast(tok)\nbuild_ast.c:100"]

        subgraph SPLIT["operator scan (left-associative)"]
            direction LR
            FLO["find_logical_op()\n→ NULL (no &amp;&amp; or ||)"]
            FPO["find_pipe_op()\n→ split_pts = TOK_PIPE"]
        end

        SAO["_split_ast_op(tok, split_pts)\nnode_type = NODE_PIPE\nsever list at pipe token"]

        subgraph RECURSE["recursive build_ast()"]
            direction LR
            LEFT_CMD["build_ast([env])\n_parse_cmd()\n→ NODE_CMD\n  args: [&quot;env&quot;, NULL]\n  redirs: NULL"]
            RIGHT_CMD["build_ast([grep]→[mskn])\n_parse_cmd()\n→ NODE_CMD\n  args: [&quot;grep&quot;,&quot;mskn&quot;, NULL]\n  redirs: NULL"]
        end

        AST_OP["ast_new_op(NODE_PIPE, left, right)\nast_utils.c:31"]
        AST_TREE["t_ast_node tree\n     NODE_PIPE\n    /         \\\nNODE_CMD    NODE_CMD\n[env,NULL]  [grep,mskn,NULL]"]

        BA --> SPLIT
        FLO --> FPO --> SAO
        SAO --> RECURSE
        RECURSE --> AST_OP
        AST_OP --> AST_TREE
    end

    %% ─── EXECUTOR ────────────────────────────────────────────────────────────
    subgraph EXECUTOR["Stage 5 · Executor  (srcs/executor/)"]
        direction TB
        ENVP["generate_envp_array(ms→env_list)\n→ char **envp for execve"]
        EA["exec_ast(ms, NODE_PIPE)\nexec_ast.c:56\n→ exec_pipe()"]

        subgraph PIPE_SETUP["exec_pipe()  exec_pipe.c:31"]
            direction TB
            PIPE["pipe(pfd)\npfd[0]=read  pfd[1]=write"]
            FLEFT["fork() → pid_left"]
            FRIGHT["fork() → pid_right"]
        end

        subgraph LEFT_CHILD["Child LEFT — env  exec_pipe.c:15"]
            direction TB
            LC1["close(pfd[0])"]
            LC2["dup2(pfd[1], STDOUT)\nstdout → pipe write end"]
            LC3["close(pfd[1])"]
            LC4["exec_ast → dispatch_cmd\n_is_env_unsafe(&quot;env&quot;) → false\nfork() → execute_child()"]
            LC5["_is_builtin(&quot;env&quot;) → TRUE\nexec_builtin() writes env vars\nto stdout = pipe write end"]
            LC1 --> LC2 --> LC3 --> LC4 --> LC5
        end

        subgraph RIGHT_CHILD["Child RIGHT — grep  exec_pipe.c:23"]
            direction TB
            RC1["close(pfd[1])"]
            RC2["dup2(pfd[0], STDIN)\nstdin ← pipe read end"]
            RC3["close(pfd[0])"]
            RC4["exec_ast → dispatch_cmd\n_is_env_unsafe(&quot;grep&quot;) → false\nfork() → execute_child()"]
            RC5["_is_builtin(&quot;grep&quot;) → FALSE\nget_cmd_path() → &quot;/usr/bin/grep&quot;\nexecve(&quot;/usr/bin/grep&quot;,\n  [&quot;grep&quot;,&quot;mskn&quot;,NULL],\n  ms→envp)"]
            RC1 --> RC2 --> RC3 --> RC4 --> RC5
        end

        WAIT["PARENT:\nclose(pfd[0,1])\nwaitpid(pid_left)\nwaitpid(pid_right)\nms→last_status = exit code"]

        ENVP --> EA
        EA --> PIPE_SETUP
        PIPE --> FLEFT --> LEFT_CHILD
        PIPE --> FRIGHT --> RIGHT_CHILD
        LEFT_CHILD -->|"env output flows through pipe"| RIGHT_CHILD
        LEFT_CHILD --> WAIT
        RIGHT_CHILD --> WAIT
    end

    %% ─── CLEANUP ─────────────────────────────────────────────────────────────
    subgraph CLEANUP["Stage 6 · Cleanup  (main.c)"]
        direction LR
        FA["free_str_array(ms→envp)"]
        FR["free_ast(ms→ast_root)"]
        LOOP["→ back to readline()"]
        FA --> FR --> LOOP
    end

    %% ─── INTER-STAGE FLOW ────────────────────────────────────────────────────
    PI --> LX
    TOK_LIST --> ETL
    TOK_LIST2 --> BA
    AST_TREE --> ENVP
    WAIT --> FA

    %% ─── LINK STYLES — force all arrows visible on dark bg ──────────────────
    linkStyle default stroke:#89b4fa,stroke-width:2px,fill:none,color:#cdd6f4

    %% ─── NODE STYLES ─────────────────────────────────────────────────────────
    classDef stage fill:#1e1e2e,stroke:#89b4fa,stroke-width:2px,color:#cdd6f4
    classDef data  fill:#1e3a2f,stroke:#a6e3a1,stroke-width:2px,color:#a6e3a1
    classDef note  fill:#2d1f0e,stroke:#fab387,stroke-width:1px,color:#fab387

    class RL,PI,LX,PC,TN,TAB,ETL,EWQ,EWP,DOLLAR,KL,GEV,AV,BA,FLO,FPO,SAO,AST_OP,ENVP,EA,PIPE,FLEFT,FRIGHT,LC1,LC2,LC3,LC4,LC5,RC1,RC2,RC3,RC4,RC5,WAIT,FA,FR,LOOP,HO,HQ,EW,SK stage
    class RAW,TOK_LIST,TOK_LIST2,AST_TREE,LEFT_CMD,RIGHT_CMD data
    class LSM,QUOTE_RULE note
